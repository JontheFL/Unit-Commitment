    "# Interactive scenario analysis - change scenario_to_check to any value from 0 to num_scenarios-1\n",
    "scenario_to_check = 27  # Change this to check different scenarios\n",
    "\n",
    "if scenario_to_check < 0 or scenario_to_check >= len(model.S):\n",
