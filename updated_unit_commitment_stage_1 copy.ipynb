    "    print(f\"\\nPenalty Summary:\")\n",
    "    print(f\"  - Load mismatch penalty: {load_penalty:,.2f} €\")\n",
    "    print(f\"  - Min/Max violations penalty: {minmax_penalty:,.2f} €\")\n",
    "    print(f\"  - Total penalty: {total_penalty:,.2f} €\")\n",
    "    \n",
    "    if total_penalty == 0:\n",
    "        print(f\"\\n✓ No violations in scenario {scenario_to_check}!\")\n",
    "    else:\n",
    "        print(f\"\\nRanking: Scenario {scenario_to_check} is ranked #{sorted(scenario_total_penalties.values(), reverse=True).index(total_penalty) + 1} worst out of {len(model.S)} scenarios\")\n",
    "        \n",
