    "                            violation = f\"Above max by {p_max_slack_val:.1f} kW\"\n",
    "                        \n",
    "                        print(f\"{t:<3} | {g:<4} | {status_str:<6} | {p_val:<8.1f} | {model.p_min[g]:<8.0f} | {model.p_max[g]:<8.0f} | \"\n",
    "                              f\"{p_min_slack_val:<10.2f} | {p_max_slack_val:<10.2f} | {violation:<25}\")\n",
    "                \n",
    "                print(\"\\nSummary by Generator:\")\n",
    "                for g in model.G:\n",
