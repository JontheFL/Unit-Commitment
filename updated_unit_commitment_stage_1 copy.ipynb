    "        print(\"-\" * 120)\n",
    "        \n",
    "        for t in range(24):\n",
    "            load_val = model.hourly_load[t]\n",
    "            wind_val = (val_or_number(model.wind_samples[t, scenario_to_check]) or 0) * (val_or_number(model.u_wind[t]) or 0)\n",
    "            solar_val = (val_or_number(model.solar_samples[t, scenario_to_check]) or 0) * (val_or_number(model.u_solar[t]) or 0)\n",
    "            net_demand = load_val - wind_val - solar_val\n",
    "            \n",
    "            gen_sum = sum(val_or_number(model.p[g, t, scenario_to_check]) or 0 for g in model.G)\n",
    "            surplus_val = val_or_number(model.surplus[t, scenario_to_check]) or 0\n",
    "            deficit_val = val_or_number(model.deficit[t, scenario_to_check]) or 0\n",
    "            \n",
    "            minmax_slack = sum(val_or_number(model.p_min_slack[g, t, scenario_to_check]) or 0 for g in model.G) + \\\n",
    "                          sum(val_or_number(model.p_max_slack[g, t, scenario_to_check]) or 0 for g in model.G)\n",
    "            \n",
    "            row = (f\"{t:<3} | {load_val:<8.0f} | {wind_val:<8.0f} | {solar_val:<8.0f} | {net_demand:<12.0f} | \"\n",
    "                   f\"{gen_sum:<10.0f} | {surplus_val:<10.1f} | {deficit_val:<10.1f} | {minmax_slack:<10.1f}\")\n",
    "            \n",
    "            # Highlight rows with violations\n",
    "            hour_penalty = penalty_weight * (surplus_val + deficit_val) + penalty_min_max * minmax_slack\n",
    "            if hour_penalty > 0:\n",
    "                row += f\" [{hour_penalty:,.0f}€]\"\n",
    "            \n",
    "            print(row)\n",
