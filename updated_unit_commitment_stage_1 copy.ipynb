    "else:\n",
    "    load_penalty = scenario_load_penalties[scenario_to_check]\n",
    "    minmax_penalty = scenario_minmax_penalties[scenario_to_check]\n",
    "    total_penalty = scenario_total_penalties[scenario_to_check]\n",
    "    \n",
    "    print(f\"\\n{'='*120}\")\n",
